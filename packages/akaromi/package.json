{
  "name": "@NamelessLiberty/akaromi",
  "version": "0.0.1",
  "private": true,
  "description": "Akaromi zero-knowledge password, credential, and SSH key manager",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config/*": "./src/config/*.tsx",
    "./context/*": "./src/context/*.tsx",
    "./navigation/*": "./src/navigation/*.tsx",
    "./settings/*": "./src/settings/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./*": "./src/*.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "dependencies": {
    "@NamelessLiberty/elysia": "workspace:*",
    "@NamelessLiberty/shared": "workspace:*",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tabler/icons-react": "^3.52.0",
    "@workspace/ui": "workspace:*",
    "sonner": "^2.0.8"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workspace/typescript-config": "workspace:*",
    "next": "^16.4.6",
    "next-intl": "^4.15.1",
    "typescript": "^7.0.2"
  }
}
