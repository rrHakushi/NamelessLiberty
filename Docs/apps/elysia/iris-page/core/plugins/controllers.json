                    "kind": "var_def",
                    "title": "Define `groupDefinitions`, `groupUses`, `code`",
                    "payload": "const groupDefinitions = batches.map((batch, bIdx) => { return `const _group_${bIdx} = new Elysia()\\n ${batch.map((name) => `.use(${name})`).join('\\n ')}` })\nconst groupUses = batches.map((_, bIdx) => `.use(_group_${bIdx})`)\nconst code = [ '// [AUTO-GENERATED] DO NOT EDIT MANUALLY', '// Generated by @NamelessLiberty/elysia controllers plugin for Eden Treaty static typing.', ...importStatements, '', ...groupDefinitions, '', ....join('\n')",
