                    "payload": "const importStatements: string[] = [\"import { Elysia } from 'elysia'\"]\nconst chainCalls: string[] = []",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "exp_generateStaticManifest_3_4",
