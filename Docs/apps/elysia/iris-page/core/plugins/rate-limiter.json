                "id": "core/plugins/rate-limiter.ts-resolveRateLimitKey",
                "title": "function resolveRateLimitKey",
                "description": "Resolves a rate-limit key in strict multi-tier hierarchy: 1. Authenticated User ID (`usr:<userId>`) 2. API Key ID or SHA-256 hash (`key:<hash>`) 3. Client IP + Device ID (`dev:<ip>:<deviceId>`) 4. Anonymous IP + User-Agent fingerprint (`ip:<ip>:<uaHash>`) @param ctx - Request route execution context @returns Unique string identifying the client quota bucket",
                "steps": [
                  {
                    "id": "exp_resolveRateLimitKey_0_1",
                    "kind": "var_def",
                    "title": "Define `request`, `session`, `userId`",
                    "payload": "const request = ctx?.request\nconst session = ctx?.session as any\nconst userId = session?.getUser?.()?.id ?? session?.user?.id",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "exp_resolveRateLimitKey_1_2",
                    "kind": "selection",
                    "title": "`userId`",
                    "selectionMode": "if_else",
