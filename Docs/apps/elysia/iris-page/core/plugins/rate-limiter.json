                    "thenBranch": [
                      {
                        "id": "exp_resolveRateLimitKey_1_2_then_0_2_1",
                        "kind": "return",
                        "title": "",
                        "returnValue": "``usr:${userId}``"
                      }
                    ],
                    "elseBranch": []
                  },
                  {
                    "id": "exp_resolveRateLimitKey_2_3",
                    "kind": "selection",
                    "title": "`session?.apiKeyId`",
                    "selectionMode": "if_else",
                    "condition": "`session?.apiKeyId`",
                    "thenBranch": [
                      {
                        "id": "exp_resolveRateLimitKey_2_3_then_0_3_1",
                        "kind": "return",
                        "title": "",
                        "returnValue": "``key:${session.apiKeyId}``"
                      }
                    ],
                    "elseBranch": []
                  },
                  {
                    "id": "exp_resolveRateLimitKey_3_4",
                    "kind": "selection",
                    "title": "`request?.headers`",
                    "selectionMode": "if_else",
                    "condition": "`request?.headers`",
                    "thenBranch": [
                      {
                        "id": "exp_resolveRateLimitKey_3_4_then_0_4_1",
                        "kind": "var_def",
                        "title": "Define `rawApiKey`",
                        "payload": "const rawApiKey = request.headers.get('x-api-key') || request.headers.get('apikey') || request.headers.get(\"authorization\")?.startsWith(\"ApiKey \") ? request.headers.get(\"authorization\")?.slice(7).trim() : null",
                        "payloadLanguage": "typescript"
                      },
                      {
                        "id": "exp_resolveRateLimitKey_3_4_then_1_4_2",
                        "kind": "selection",
                        "title": "`rawApiKey`",
                        "selectionMode": "if_else",
                        "condition": "`rawApiKey`",
                        "thenBranch": [
                          {
                            "id": "exp_resolveRateLimitKey_3_4_then_1_4_2_then_0_4_2_1",
                            "kind": "var_def",
                            "title": "Define `hash`",
                            "payload": "const hash = createHash('sha256').update(rawApiKey.trim()).digest('hex').slice(0, 16)",
                            "payloadLanguage": "typescript"
                          },
                          {
                            "id": "exp_resolveRateLimitKey_3_4_then_1_4_2_then_1_4_2_2",
                            "kind": "return",
                            "title": "",
                            "returnValue": "``key:${hash}``"
                          }
                        ],
                        "elseBranch": []
                      },
                      {
                        "id": "exp_resolveRateLimitKey_3_4_then_2_4_3",
                        "kind": "step",
                        "title": "Calls `request.headers.get` and stores result as `authHeader`"
                      },
                      {
                        "id": "exp_resolveRateLimitKey_3_4_then_3_4_4",
                        "kind": "selection",
                        "title": "`authHeader?.startsWith(\"Bearer \")`",
                        "selectionMode": "if_else",
                        "condition": "`authHeader?.startsWith(\"Bearer \")`",
                        "thenBranch": [
                          {
                            "id": "exp_resolveRateLimitKey_3_4_then_3_4_4_then_0_4_4_1",
                            "kind": "var_def",
                            "title": "Define `token`, `tokenHash`",
                            "payload": "const token = authHeader.slice(7).trim()\nconst tokenHash = createHash('sha256').update(token).digest('hex').slice(0, 16)",
                            "payloadLanguage": "typescript"
                          },
                          {
                            "id": "exp_resolveRateLimitKey_3_4_then_3_4_4_then_1_4_4_2",
                            "kind": "return",
                            "title": "",
                            "returnValue": "``tok:${tokenHash}``"
