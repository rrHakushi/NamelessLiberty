        "type": "div",
        "props": {
          "className": "space-y-4"
        },
        "children": [
          {
            "type": "AlgoBuilder",
            "key": "exp-algo-getDomainConfig",
            "props": {
              "mode": "render",
              "allowModeToggle": true,
              "defaultValue": {
                "id": "core/utils/domain.ts-getDomainConfig",
                "title": "function getDomainConfig",
                "description": "Canonical domain, origin, and cookie configuration derived strictly from `NEXT_PUBLIC_URL`. Eliminates redundant environment variables (RP_ID, COOKIE_DOMAIN, NEXTAUTH_URL).",
                "steps": [
                  {
                    "id": "exp_getDomainConfig_0_1",
                    "kind": "var_def",
                    "title": "Define `urlStr`",
                    "payload": "const urlStr = Bun.env.NEXT_PUBLIC_URL",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "exp_getDomainConfig_1_2",
                    "kind": "selection",
                    "title": "`!urlStr`",
                    "selectionMode": "if_else",
                    "condition": "`!urlStr`",
                    "thenBranch": [
                      {
                        "id": "exp_getDomainConfig_1_2_then_0_2_1",
                        "kind": "error",
                        "code": "Error",
                        "httpStatus": 500,
                        "message": "NEXT_PUBLIC_URL environment variable is required"
                      }
                    ],
                    "elseBranch": []
                  },
                  {
                    "id": "exp_getDomainConfig_2_3",
                    "kind": "var_def",
                    "title": "Define `url`, `hostname`, `isLocalhost`",
                    "payload": "const url = new URL(urlStr)\nconst hostname = url.hostname\nconst isLocalhost = hostname === 'localhost' || hostname === '127.0.0.1'",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "exp_getDomainConfig_3_4",
                    "kind": "var_def",
                    "title": "Define `rpId`",
                    "description": "WebAuthn RP_ID (hostname only, without port or protocol).",
                    "payload": "const rpId = hostname",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "exp_getDomainConfig_4_5",
                    "kind": "var_def",
                    "title": "Define `cookieDomain`",
                    "description": "Cookie domain: in production, set to root domain with leading dot (e.g. \".runerra.org\") so subdomains share it, or omit on localhost so browsers accept it across localhost ports.",
                    "payload": "let cookieDomain: string | undefined = undefined",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "exp_getDomainConfig_5_6",
                    "kind": "selection",
                    "title": "`!isLocalhost`",
                    "selectionMode": "if_else",
                    "condition": "`!isLocalhost`",
                    "thenBranch": [
                      {
                        "id": "exp_getDomainConfig_5_6_then_0_6_1",
                        "kind": "var_def",
                        "title": "Define `parts`",
                        "payload": "const parts = hostname.split('.')",
                        "payloadLanguage": "typescript"
                      },
                      {
                        "id": "exp_getDomainConfig_5_6_then_1_6_2",
                        "kind": "step",
                        "title": "Assign `cookieDomain`",
                        "payload": "cookieDomain = parts.length >= 2 ? `.${parts.slice(-2).join('.')}` : `.${hostname}`",
                        "payloadLanguage": "typescript"
                      }
                    ],
                    "elseBranch": []
                  },
                  {
                    "id": "exp_getDomainConfig_6_7",
                    "kind": "var_def",
                    "title": "Define `isSecure`",
                    "payload": "const isSecure = Bun.env.BUN_ENV === 'production' && !isLocalhost",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "exp_getDomainConfig_7_8",
                    "kind": "return",
                    "title": "",
                    "payload": "{\n  \"url\": \"<urlStr>\",\n  \"origin\": \"<url.origin>\",\n  \"hostname\": \"<hostname>\",\n  \"rpId\": \"<rpId>\",\n  \"cookieDomain\": \"<cookieDomain>\",\n  \"isSecure\": \"<isSecure>\"\n}",
                    "payloadLanguage": "json"
                  }
                ]
              }
            }
          }
        ]
