          {
            "type": "AlgoBuilder",
            "key": "exp-algo-getBullMQConnectionOptions",
            "props": {
              "mode": "render",
              "allowModeToggle": true,
              "defaultValue": {
                "id": "core/bullmq/redis.ts-getBullMQConnectionOptions",
                "title": "function getBullMQConnectionOptions",
                "description": "Parses and validates Redis environment variables for BullMQ queues and workers. Enforces `maxRetriesPerRequest: null` as required by BullMQ blocking commands.",
                "steps": [
                  {
                    "id": "exp_getBullMQConnectionOptions_0_1",
                    "kind": "var_def",
                    "title": "Define `host`, `portRaw`",
                    "payload": "const host = Bun.env.REDIS_HOST\nconst portRaw = Bun.env.REDIS_PORT",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "exp_getBullMQConnectionOptions_1_2",
                    "kind": "selection",
                    "title": "`!host || !portRaw`",
                    "selectionMode": "if_else",
                    "condition": "`!host || !portRaw`",
                    "thenBranch": [
                      {
                        "id": "exp_getBullMQConnectionOptions_1_2_then_0_2_1",
                        "kind": "error",
                        "code": "Error",
                        "httpStatus": 500,
                        "message": "Missing required Redis environment variable(s): REDIS_HOST and/or REDIS_PORT"
                      }
                    ],
                    "elseBranch": []
                  },
                  {
                    "id": "exp_getBullMQConnectionOptions_2_3",
                    "kind": "step",
                    "title": "Calls `Number` and stores result as `port`"
                  },
                  {
                    "id": "exp_getBullMQConnectionOptions_3_4",
                    "kind": "selection",
                    "title": "`!Number.isFinite(port) || port <= 0`",
                    "selectionMode": "if_else",
                    "condition": "`!Number.isFinite(port) || port <= 0`",
                    "thenBranch": [
                      {
                        "id": "exp_getBullMQConnectionOptions_3_4_then_0_4_1",
                        "kind": "error",
                        "code": "Error",
                        "httpStatus": 500,
                        "message": "Invalid REDIS_PORT value: ${portRaw}"
                      }
                    ],
                    "elseBranch": []
                  },
                  {
                    "id": "exp_getBullMQConnectionOptions_4_5",
                    "kind": "var_def",
                    "title": "Define `dbRaw`, `db`",
                    "payload": "const dbRaw = Bun.env.REDIS_DB\nconst db = dbRaw !== undefined && dbRaw !== '' ? Number(dbRaw) : 0",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "exp_getBullMQConnectionOptions_5_6",
                    "kind": "return",
                    "title": "",
                    "payload": "{\n  \"host\": \"<host>\",\n  \"port\": \"<port>\",\n  \"...Bun.env.REDIS_PASSWORD ? { password: Bun.env.REDIS_PASSWORD } : {}\": \"...\",\n  \"db\": \"<Number.isFinite(db) ? db : 0>\",\n  \"maxRetriesPerRequest\": null,\n  \"enableReadyCheck\": false,\n  \"retryStrategy\": \"<(times: number) => Math.min(times * 250, 5000)>\"\n}",
                    "payloadLanguage": "json"
                  }
                ]
              }
            }
          },
          {
            "type": "AlgoBuilder",
            "key": "exp-algo-isTransientSocketError",
            "props": {
              "mode": "render",
              "allowModeToggle": true,
              "defaultValue": {
                "id": "core/bullmq/redis.ts-isTransientSocketError",
                "title": "function isTransientSocketError",
                "description": "Checks whether a Redis/BullMQ error is a transient socket reset that BullMQ reconnects automatically.",
                "steps": [
                  {
                    "id": "exp_isTransientSocketError_0_1",
                    "kind": "var_def",
                    "title": "Define `message`",
                    "payload": "const message = (err as Error)?.message || String(err || '')",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "exp_isTransientSocketError_1_2",
                    "kind": "return",
                    "title": "",
                    "returnValue": "`message.includes('ECONNRESET') || message.includes('EPIPE') || message.includes('ETIMEDOUT') || message.includes('Connection is closed') || message.includes('Socket closed unexpectedly')`"
                  }
                ]
              }
            }
          },
          {
            "type": "AlgoBuilder",
            "key": "exp-algo-attachBullMQErrorHandler",
            "props": {
              "mode": "render",
              "allowModeToggle": true,
              "defaultValue": {
                "id": "core/bullmq/redis.ts-attachBullMQErrorHandler",
                "title": "function attachBullMQErrorHandler",
                "description": "Attaches standard error logging to any BullMQ Queue, Worker, or QueueEvents emitter.",
                "steps": [
                  {
                    "id": "exp_attachBullMQErrorHandler_0_1",
                    "kind": "warning",
                    "code": "Warning",
                    "message": "error', (err: Error) => { if (isTransientSocketError(err)) { logger.warn(`[${scope}] Transient Redis socket error (auto-reconnecting): ${err.message}`) return } logger.error(`[${scope}] BullMQ error:`, err) }"
                  }
                ]
              }
            }
          }
        ]
