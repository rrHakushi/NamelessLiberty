              "defaultValue": {
                "id": "apps/carina/favorites/favorites.serv.ts-CarinaFavoritesServ-parseFavoriteType",
                "title": "CarinaFavoritesServ.parseFavoriteType(raw)",
                "description": "Helper to normalize and validate favorite category / type string into FavoriteType enum.",
                "steps": [
                  {
                    "id": "m_CarinaFavoritesServ_parseFavoriteType_0_1",
                    "kind": "var_def",
                    "title": "Define `normalized`",
                    "payload": "const normalized = raw.trim().replace(/-/g, '_').toUpperCase()",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "m_CarinaFavoritesServ_parseFavoriteType_1_2",
                    "kind": "selection",
                    "title": "`!VALID_FAVORITE_TYPES.includes(normalized as ValidFavoriteType)`",
                    "selectionMode": "if_else",
                    "condition": "`!VALID_FAVORITE_TYPES.includes(normalized as ValidFavoriteType)`",
                    "thenBranch": [
                      {
                        "id": "m_CarinaFavoritesServ_parseFavoriteType_1_2_then_0_2_1",
                        "kind": "error",
                        "code": "BadRequest",
                        "httpStatus": 400,
                        "message": "Invalid favorite category: '${raw}'. Must be one of: ${VALID_FAVORITE_TYPES.map((t) => t.toLowerCase()).join(', ')}"
                      }
                    ],
                    "elseBranch": []
                  },
                  {
                    "id": "m_CarinaFavoritesServ_parseFavoriteType_2_3",
                    "kind": "return",
                    "title": "",
                    "returnValue": "`normalized as FavoriteType`"
                  }
                ]
              }
            }
