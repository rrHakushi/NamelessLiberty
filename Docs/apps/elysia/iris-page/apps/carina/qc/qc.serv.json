              "defaultValue": {
                "id": "apps/carina/qc/qc.serv.ts-CarinaQcServ-generateSession",
                "title": "CarinaQcServ.generateSession(body)",
                "description": "Generate an 8-character human-readable pairing code and 256-bit polling session token.",
                "steps": [
                  {
                    "id": "m_CarinaQcServ_generateSession_0_1",
                    "kind": "var_def",
                    "title": "Define `CHARS`",
                    "payload": "const CHARS = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "m_CarinaQcServ_generateSession_1_2",
                    "kind": "step",
                    "title": "Calls `randomBytes` and stores result as `bytes`"
                  },
                  {
                    "id": "m_CarinaQcServ_generateSession_2_3",
                    "kind": "var_def",
                    "title": "Define `rawCode`",
                    "payload": "let rawCode = ''",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "m_CarinaQcServ_generateSession_3_4",
                    "kind": "iteration",
                    "title": "Loop `i < 8`",
                    "loopType": "while",
                    "condition": "Loop `i < 8`",
                    "children": [
                      {
                        "id": "m_CarinaQcServ_generateSession_3_4_loop_0_4_1",
                        "kind": "step",
                        "title": "Assign `rawCode`",
                        "payload": "rawCode += CHARS[bytes[i]! % CHARS.length]",
                        "payloadLanguage": "typescript"
                      }
                    ]
                  },
                  {
                    "id": "m_CarinaQcServ_generateSession_4_5",
                    "kind": "var_def",
                    "title": "Define `code`, `sessionToken`, `baseUrl`, `qrPayload`, `sessionData`",
                    "payload": "const code = `${rawCode.slice(0, 4)}-${rawCode.slice(4, 8)}`\nconst sessionToken = randomBytes(32).toString('hex')\nconst baseUrl = getDomainConfig().url\nconst qrPayload = `${baseUrl.replace(/\\/$/, '')}/qc?code=${code}`\nconst sessionData: QuickConnectSessionData = { status: 'pending', code, deviceName: body?.deviceName ?? 'Device', userId: null, }",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "m_CarinaQcServ_generateSession_5_6",
                    "kind": "step",
                    "title": "Cache `set`"
                  },
                  {
                    "id": "m_CarinaQcServ_generateSession_6_7",
                    "kind": "return",
                    "title": "",
                    "payload": "{\n  \"code\": \"<code>\",\n  \"sessionToken\": \"<sessionToken>\",\n  \"qrPayload\": \"<qrPayload>\",\n  \"expiresIn\": 300\n}",
                    "payloadLanguage": "json"
                  }
                ]
              }
            }
