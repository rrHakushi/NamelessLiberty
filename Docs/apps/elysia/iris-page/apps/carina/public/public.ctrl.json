                            "type": "TableCell",
                            "props": {
                              "className": "font-mono text-xs text-foreground text-start"
                            },
                            "text": "File Not Found: ${sanitizedKey}"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
