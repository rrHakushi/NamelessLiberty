                "id": "apps/carina/public/public.serv.ts-PublicAssetsServ-sanitizeKey",
                "title": "PublicAssetsServ.sanitizeKey(rawKey)",
                "description": "Sanitize asset key to prevent path traversal vulnerabilities.",
                "steps": [
                  {
                    "id": "m_PublicAssetsServ_sanitizeKey_0_1",
                    "kind": "selection",
                    "title": "`!rawKey || typeofrawKey !== 'string'`",
