                        "message": "Asset key cannot be empty"
                      }
                    ],
                    "elseBranch": []
                  },
                  {
                    "id": "m_PublicAssetsServ_sanitizeKey_1_2",
                    "kind": "var_def",
                    "title": "Define `decoded`",
                    "payload": "let decoded: string",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "m_PublicAssetsServ_sanitizeKey_2_3",
                    "kind": "try_catch_finally",
                    "title": "Try block",
                    "catchVar": "err",
                    "tryBlock": [
                      {
                        "id": "m_PublicAssetsServ_sanitizeKey_2_3_try_0_3_1",
                        "kind": "step",
                        "title": "Assign `decoded`",
                        "payload": "decoded = decodeURIComponent(rawKey).trim()",
                        "payloadLanguage": "typescript"
                      }
                    ],
                    "catchBlock": [
                      {
                        "id": "m_PublicAssetsServ_sanitizeKey_2_3_catch_0_4_1",
                        "kind": "error",
                        "code": "BadRequest",
