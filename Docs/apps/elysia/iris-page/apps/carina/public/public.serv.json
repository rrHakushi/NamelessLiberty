                    "kind": "selection",
                    "title": "`decoded.includes('..') || decoded.includes('\u0000') || decoded.startsWith('/') || decoded.startsWith('\\')`",
                    "selectionMode": "if_else",
                    "condition": "`decoded.includes('..') || decoded.includes('\u0000') || decoded.startsWith('/') || decoded.startsWith('\\')`",
