                "description": "Exported algorithm sequence",
                "steps": [
                  {
                    "id": "exp_normalizeScoreTo10_0_1",
                    "kind": "selection",
                    "title": "`s === null || s === undefined || s <= 0`",
                    "selectionMode": "if_else",
                    "condition": "`s === null || s === undefined || s <= 0`",
                    "thenBranch": [
                      {
                        "id": "exp_normalizeScoreTo10_0_1_then_0_1_1",
                        "kind": "return",
                        "title": "",
                        "returnValue": "`null`"
                      }
                    ],
                    "elseBranch": []
                  },
                  {
                    "id": "exp_normalizeScoreTo10_1_2",
                    "kind": "var_def",
                    "title": "Define `normalized`",
                    "payload": "const normalized = s > 10 ? s / 10 : s",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "exp_normalizeScoreTo10_2_3",
                    "kind": "return",
                    "title": "",
                    "returnValue": "`Math.min(10, Math.max(0.1, Math.round(normalized * 100) / 100))`"
                  }
                ]
              }
