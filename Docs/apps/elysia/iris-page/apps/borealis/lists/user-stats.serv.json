                "description": "Calculates comprehensive stats for user's anime list.",
                "steps": [
                  {
                    "id": "m_MediaStatsService_getAnimeStats_0_1",
                    "kind": "var_def",
                    "title": "Define `cacheKey`",
                    "payload": "const cacheKey = `iris:stats:${userId}:anime:${period?.year ?? \"all\"}:${period?.quarter ?? \"all\"}:${period?.month ?? \"all\"}:${isOwner ? \"1\" : \"0\"}`",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "m_MediaStatsService_getAnimeStats_1_2",
                    "kind": "return",
                    "title": "",
                    "returnValue": "`cache.getOrSet(cacheKey, async () => { const { start, end } = resolveDateRange(period) const isPeriodFiltered = Boolean(start || end) let q = prisma.orm.public.AnimeList.where({ userId }) if (!isOwner) { q = q.where({ private: false }) ..., STATS_CACHE_TTL_SECONDS)`"
