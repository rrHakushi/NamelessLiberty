                "steps": [
                  {
                    "id": "m_BorealisCalendarServ_getCalendar_0_1",
                    "kind": "var_def",
                    "title": "Define `now`, `defaultStart`, `defaultEnd`, `startParam`, `endParam`, `startDate`, `endDate`, `validStart`, `validEnd`",
                    "payload": "const now = new Date()\nconst defaultStart = new Date( Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1) )\nconst defaultEnd = new Date( Date.UTC(now.getUTCFullYear(), now.getUTCMonth() + 1, 0, 23, 59, 59, 999) )\nconst startParam = typeof query?.start === 'string' ? query.start : undefined\nconst endParam = typeof query?.end === 'string' ? query.end : undefined\nconst startDate = startParam ? new Date(startParam) : defaultStart\nconst endDate = endParam ? new Date(endParam) : defaultEnd\nconst validStart = isNaN(startDate.getTime()) ? defaultStart : startDate\nconst validEnd = isNaN(endDate.getTime()) ? defaultEnd : endDate",
                    "payloadLanguage": "typescript"
                  },
