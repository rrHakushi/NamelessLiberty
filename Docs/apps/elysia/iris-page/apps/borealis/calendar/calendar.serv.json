                    "kind": "var_def",
                    "title": "Define `typesParam`, `rawTypes`, `isRequested`, `onlyInLists`, `currentUserId`",
                    "payload": "const typesParam = typeof query?.types === 'string' ? query.types : undefined\nconst rawTypes = typesParam ? typesParam .toLowerCase() .split(',') .map((t) => t.trim()) .filter(Boolean) .map((t) => (TYPE_ALIAS_MAP[t] ?? t) as CalendarMediaType) ...\nconst isRequested = (type: CalendarMediaType) => rawTypes.length === 0 || rawTypes.includes(type)\nconst onlyInLists = query?.onlyInLists === true || query?.onlyInLists === 'true' || query?.onlyInLists === '1'\nconst currentUserId = userId ?? null",
                    "payloadLanguage": "typescript"
                  },
