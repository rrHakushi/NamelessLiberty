                    "thenBranch": [
                      {
                        "id": "exp_evaluateRecordFreshness_0_1_then_0_1_1",
                        "kind": "return",
                        "title": "",
                        "payload": "{\n  \"isFresh\": false,\n  \"isHydrated\": false,\n  \"statusGroup\": \"one-week\",\n  \"reason\": \"Record does not exist or has no updatedAt timestamp\"\n}",
                        "payloadLanguage": "json"
                      }
                    ],
                    "elseBranch": []
                  },
                  {
                    "id": "exp_evaluateRecordFreshness_1_2",
                    "kind": "step",
                    "title": "Calls `isRecordHydrated` and stores result as `hydrated`"
                  },
                  {
