                        "kind": "var_def",
                        "title": "Define `targetDate`",
                        "payload": "const targetDate = new Date(lastUpdated)",
                        "payloadLanguage": "typescript"
                      },
                      {
                        "id": "exp_evaluateRecordFreshness_7_8_then_1_8_2",
                        "kind": "step",
                        "title": "Calls `targetDate.setMonth`"
                      },
                      {
                        "id": "exp_evaluateRecordFreshness_7_8_then_2_8_3",
                        "kind": "var_def",
                        "title": "Define `isFresh`",
                        "payload": "const isFresh = today.getTime() < targetDate.getTime()",
                        "payloadLanguage": "typescript"
