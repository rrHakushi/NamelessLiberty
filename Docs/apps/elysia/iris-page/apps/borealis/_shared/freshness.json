                        "payload": "{\n  \"isFresh\": \"<isFresh>\",\n  \"isHydrated\": true,\n  \"statusGroup\": \"three-months\",\n  \"reason\": \"<isFresh ? `Status \\\"${normStatus}\\\" is fresh until ${targetDate.toISOString().split('T')[0]}` : `Status \\\"${normStatus}\\\" reached 3-month threshold (${targetDate.toISOString().split('T')[0]})`>\"\n}",
