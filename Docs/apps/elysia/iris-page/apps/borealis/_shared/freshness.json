                        "kind": "return",
                        "title": "",
                        "payload": "{\n  \"isFresh\": false,\n  \"isHydrated\": false,\n  \"statusGroup\": \"one-week\",\n  \"reason\": \"Unhydrated stub (missing provider sync timestamp)\"\n}",
                        "payloadLanguage": "json"
                      }
                    ],
                    "elseBranch": []
                  },
                  {
                    "id": "exp_evaluateRecordFreshness_3_4",
                    "kind": "step",
                    "title": "Calls `normalizeToStartOfDay` and stores result as `today`"
                  },
                  {
                    "id": "exp_evaluateRecordFreshness_4_5",
