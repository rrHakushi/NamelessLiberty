            "type": "AlgoBuilder",
            "key": "method-algo-AkaromiVaultService-syncVault",
            "props": {
              "mode": "render",
              "allowModeToggle": true,
              "defaultValue": {
                "id": "apps/akaromi/vault/vault.serv.ts-AkaromiVaultService-syncVault",
                "title": "AkaromiVaultService.syncVault(userId, since)",
                "description": "Synchronizes full or incremental vault state for the authenticated user.",
                "steps": [
                  {
                    "id": "m_AkaromiVaultService_syncVault_0_1",
                    "kind": "var_def",
                    "title": "Define `now`, `sinceDate`, `hasValidSince`",
                    "payload": "const now = new Date()\nconst sinceDate = since ? new Date(since) : null\nconst hasValidSince = sinceDate !== null && !isNaN(sinceDate.getTime())",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "m_AkaromiVaultService_syncVault_1_2",
                    "kind": "step",
                    "title": "Database `query` on `PassCipher` and stores it as `query`"
                  },
                  {
                    "id": "m_AkaromiVaultService_syncVault_2_3",
                    "kind": "selection",
                    "title": "`hasValidSince && sinceDate`",
                    "selectionMode": "if_else",
                    "condition": "`hasValidSince && sinceDate`",
                    "thenBranch": [
                      {
                        "id": "m_AkaromiVaultService_syncVault_2_3_then_0_3_1",
                        "kind": "step",
                        "title": "Assign `query`",
                        "payload": "query = query.where((c) => c.updatedAt.gte(sinceDate))",
                        "payloadLanguage": "typescript"
                      }
                    ],
                    "elseBranch": []
                  },
                  {
                    "id": "m_AkaromiVaultService_syncVault_3_4",
                    "kind": "step",
                    "title": "Calls `query.orderBy((c) => c.updatedAt.desc()).all` and stores result as `rawCiphers`"
                  },
                  {
                    "id": "m_AkaromiVaultService_syncVault_4_5",
                    "kind": "var_def",
                    "title": "Define `deletedCipherIds`",
                    "payload": "const deletedCipherIds = rawCiphers.filter((c) => c.deletedAt !== null).map((c) => c.id)",
                    "payloadLanguage": "typescript"
                  },
                  {
                    "id": "m_AkaromiVaultService_syncVault_5_6",
                    "kind": "return",
                    "title": "",
                    "payload": "{\n  \"success\": true,\n  \"serverTime\": \"<now.toISOString()>\",\n  \"ciphers\": \"<rawCiphers.map((c) => AkaromiCiphersServ.formatCipher(c))>\",\n  \"deletedCipherIds\": \"<deletedCipherIds>\"\n}",
                    "payloadLanguage": "json"
                  }
                ]
              }
            }
          },
