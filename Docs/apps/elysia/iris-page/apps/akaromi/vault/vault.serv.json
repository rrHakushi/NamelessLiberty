                "title": "AkaromiVaultService.exportVault(userId)",
                "description": "Exports full non-deleted vault data for backup or client migration.",
                "steps": [
                  {
                    "id": "m_AkaromiVaultService_exportVault_0_1",
                    "kind": "step",
                    "title": "Database `all` on `PassCipher` and stores it as `ciphers`"
                  },
                  {
                    "id": "m_AkaromiVaultService_exportVault_1_2",
                    "kind": "return",
                    "title": "",
                    "payload": "{\n  \"success\": true,\n  \"exportedAt\": \"<new Date().toISOString()>\",\n  \"ciphers\": \"<ciphers.map((c) => ({ id: c.id, type: c.type as 'LOGIN' | 'SSH_KEY', favorite: c.favorite, encryptedTitle: c.encryptedTitle, encryptedData: c.encryptedData, createdAt: toDate(c.createdAt).toISOString(), ...)>\"\n}",
                    "payloadLanguage": "json"
