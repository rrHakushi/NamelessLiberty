{
  "manifest_version": 3,
  "name": "NamelessLiberty's Akaromi",
  "version": "2.2",
  "description": "Self hosted password manager to keep your login credentials safe.",
  "browser_specific_settings": {
    "gecko": {
      "id": "akaromi@namelessliberty",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "privacy",
    "scripting",
    "clipboardWrite",
    "alarms"
  ],
  "incognito": "spanning",
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib/noble.js",
      "lib/crypto.js",
      "lib/psl.js",
      "lib/matching.js",
      "lib/totp.js",
      "lib/qr-decoder.js",
      "lib/storage.js",
      "lib/api.js",
      "background/state.js",
      "background/vault.js",
      "background/autofill.js",
      "background/passkey.js",
      "background/background.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Akaromi for Firefox"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/event-shield.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/passkey-injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/icons.js",
        "lib/totp.js",
        "content/detection.js",
        "content/badge.js",
        "content/fill.js",
        "content/menu.js",
        "content/content.js"
      ],
      "css": [
        "content/badge.css",
        "content/menu.css",
        "content/passkey.css",
        "content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-16.png",
        "icons/icon-48.png",
        "icons/icons.svg",
        "content/badge.css",
        "content/menu.css",
        "content/passkey.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src https: http://localhost:* http://127.0.0.1:* http://[::1]:*; img-src 'self' https: http://localhost:* http://127.0.0.1:* http://[::1]:* data: blob:; style-src 'self' 'unsafe-inline'"
  }
}